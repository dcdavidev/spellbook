{
  "name": "spellbook",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "lint:types": "turbo run lint:types",
    "lint:spelling": "cspell --no-progress --no-summary ."
  },
  "devDependencies": {
    "@dcdavidev/cspell-config": "workspace:*",
    "@typescript/native": "catalog:",
    "cspell": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26"
  }
}

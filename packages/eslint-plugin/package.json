{
  "name": "@dcdavidev/eslint-plugin",
  "version": "0.0.0",
  "private": false,
  "description": "A shareable ESlint plugin",
  "keywords": [
    "eslint",
    "eslint-config",
    "eslint-plugin",
    "linter",
    "code-style"
  ],
  "homepage": "https://github.com/dcdavidev/spellbook#readme",
  "bugs": {
    "url": "https://github.com/dcdavidev/spellbook/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcdavidev/spellbook.git",
    "directory": "packages/eslint-config"
  },
  "license": "MIT",
  "author": {
    "name": "Davide Di Criscito",
    "email": "info@dcdavidev.me",
    "url": "https://dcdavidev.me"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./configs": {
      "types": "./dist/configs/index.d.ts",
      "import": "./dist/configs/index.js",
      "default": "./dist/configs/index.js"
    },
    "./configs/recommended": {
      "types": "./dist/configs/recommended.d.ts",
      "import": "./dist/configs/recommended.js",
      "default": "./dist/configs/recommended.js"
    },
    "./configs/nextjs": {
      "types": "./dist/configs/nextjs.d.ts",
      "import": "./dist/configs/nextjs.js",
      "default": "./dist/configs/nextjs.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint:types": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@dcdavidev/shared-spells": "workspace:*",
    "@eslint-react/eslint-plugin": "catalog:",
    "@eslint/css": "catalog:",
    "@eslint/js": "catalog:",
    "@eslint/json": "catalog:",
    "@eslint/markdown": "catalog:",
    "@eslint/shell": "catalog:",
    "@next/eslint-plugin-next": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-jsdoc": "catalog:",
    "eslint-plugin-node-dependencies": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "eslint-plugin-unicorn": "catalog:",
    "globals": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "devDependencies": {
    "@dcdavidev/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "eslint": "catalog:",
    "typescript": ">=4.8.4 <6.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

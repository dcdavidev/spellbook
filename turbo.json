{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["src/**"]
    },
    "lint": {
       "dependsOn": ["lint:types"]
    },
    "lint:types": {
      "dependsOn": ["^lint:types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

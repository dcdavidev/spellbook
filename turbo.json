{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": [
        "lint:types",
        "//#lint:workspace",
        "//#lint:spelling",
        "//#fmt:check"
      ]
    },
    "lint:fix": {
      "dependsOn": [
        "lint:types",
        "//#lint:spelling",
        "//#lint:workspace:fix",
        "//#fmt"
      ]
    },
    "lint:types": {
      "dependsOn": ["^build"]
    },
    "//#lint:workspace": {
      "inputs": ["$TURBO_DEFAULT$", "eslint.config.*"],
      "cache": true
    },
    "//#lint:workspace:fix": {
      "cache": false
    },
    "//#lint:spelling": {
      "inputs": ["$TURBO_DEFAULT$", "cspell.config.*", ".cspell*"],
      "cache": true
    },
    "//#fmt:check": {
      "inputs": ["$TURBO_DEFAULT$", ".prettierrc*", "prettier.config.*"],
      "cache": true
    },
    "//#fmt": {
      "dependsOn": ["//#lint:workspace:fix"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

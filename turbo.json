{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["lint:types", "//#lint:spelling"]
    },
    "lint:types": {
      "dependsOn": ["^lint:types"]
    },
    "//#lint:spelling": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

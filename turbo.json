{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["lint:types", "//#lint:spelling", "//#fmt:check"]
    },
    "lint:fix": {
      "dependsOn": ["lint:types", "//#lint:spelling", "//#fmt"]
    },
    "lint:types": {
      "dependsOn": ["^build", "^lint:types"]
    },
    "//#lint:spelling": {
      "inputs": ["$TURBO_DEFAULT$", "cspell.config.*", ".cspell*"],
      "cache": true
    },
    "//#fmt:check": {
      "inputs": ["$TURBO_DEFAULT$", ".prettierrc*", "prettier.config.*"],
      "cache": true
    },
    "//#fmt": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
